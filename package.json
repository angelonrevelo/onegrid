{
  "name": "onegrid-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "oneGrid monorepo \u2014 framework-agnostic, columnar, MIT-licensed grid for 10M+ rows.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "bench": "pnpm --filter @onegrid/benchmarks test",
    "bench:headed": "pnpm --filter @onegrid/benchmarks test:headed",
    "bench:ui": "pnpm --filter @onegrid/benchmarks test:ui",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "surface:check": "node scripts/check-public-surface.mjs",
    "roadmap:check": "node scripts/check-roadmap-green.mjs",
    "api:extract": "node scripts/generate-api-reports.mjs",
    "api:check": "node scripts/generate-api-reports.mjs --check",
    "fuzz": "ONEGRID_FUZZ_RUNS=2000 pnpm -r --filter @onegrid/formula --filter @onegrid/ssrm --filter @onegrid/postgres --filter @onegrid/duckdb-join test -- --testNamePattern fuzz",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
