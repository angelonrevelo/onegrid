{
  "name": "@onegrid/a11y",
  "version": "1.0.0",
  "description": "Accessibility utilities for oneGrid: live regions, roving tabindex, ARIA grid pattern helpers. Framework-agnostic and DOM-only.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CelestialBrain/onegrid.git",
    "directory": "packages/a11y"
  },
  "homepage": "https://github.com/CelestialBrain/onegrid#readme",
  "bugs": {
    "url": "https://github.com/CelestialBrain/onegrid/issues"
  },
  "keywords": [
    "grid",
    "datagrid",
    "table",
    "data-grid",
    "accessibility",
    "a11y",
    "aria"
  ]
}
