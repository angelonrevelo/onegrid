{
  "name": "@onegrid/formula",
  "version": "1.0.0",
  "description": "oneGrid formula engine: Excel-compatible parser, dependency graph with range nodes, Adapton-style demand-driven recompute.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./excel-compat": {
      "types": "./dist/excel-compat.d.ts",
      "import": "./dist/excel-compat.js",
      "require": "./dist/excel-compat.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/data": "workspace:*",
    "@onegrid/protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./src/functions.ts",
    "./src/functions/**"
  ],
  "devDependencies": {
    "fast-check": "^4.8.0"
  }
}
