{
  "name": "@onegrid/snowflake",
  "version": "1.0.0",
  "description": "Snowflake adapter for oneGrid SSRM. Compiles BlockRequest into Snowflake SQL with double-quoted UPPER-CASE identifier resolution, positional binds, QUALIFY-based deduplication and keyset pagination; ships a STREAM-backed change-data-capture adapter.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
