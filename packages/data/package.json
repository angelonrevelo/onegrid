{
  "name": "@onegrid/data",
  "version": "1.0.0",
  "description": "oneGrid columnar data layer: Arrow-compatible tables, bitmap selection, sort cache, group tree, IVM hooks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "fast-check": "^4.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CelestialBrain/onegrid.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/CelestialBrain/onegrid#readme",
  "bugs": {
    "url": "https://github.com/CelestialBrain/onegrid/issues"
  },
  "keywords": [
    "grid",
    "datagrid",
    "table",
    "data-grid",
    "arrow",
    "columnar",
    "pivot"
  ]
}
