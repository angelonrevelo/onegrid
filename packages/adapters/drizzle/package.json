{
  "name": "@onegrid/drizzle",
  "version": "1.0.0",
  "description": "Drizzle ORM adapter for oneGrid SSRM. Translates BlockRequest into Drizzle queries against Postgres, MySQL, SQLite.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/protocol": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.36.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.20.0",
    "testcontainers": "^12.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CelestialBrain/onegrid.git",
    "directory": "packages/adapters/drizzle"
  },
  "homepage": "https://github.com/CelestialBrain/onegrid#readme",
  "bugs": {
    "url": "https://github.com/CelestialBrain/onegrid/issues"
  },
  "keywords": [
    "grid",
    "datagrid",
    "table",
    "data-grid",
    "drizzle",
    "orm"
  ]
}
